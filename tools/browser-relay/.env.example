NETWIX_RELAY_URL=https://netwix.online
# Same random token (at least 32 characters) as RONGYOK_BROWSER_RELAY_TOKEN on production.
NETWIX_RELAY_TOKEN=
BROWSER_RELAY_CHANNEL=chrome
# Use a separate persistent Chrome profile, never the everyday Chrome profile.
# Urban mode is detected when urban-extension/manifest.json exists; it uses bundled Chromium.
# Set this to .urban-profile when deploying with Urban.
BROWSER_RELAY_PROFILE=.chrome-profile
BROWSER_RELAY_HEADLESS=false
# Optional explicit path to the installed Urban extension snapshot:
# BROWSER_RELAY_URBAN_EXTENSION=C:\brainx\netwix-browser-relay\urban-extension
# Parallel episode tabs (1-4)
BROWSER_RELAY_CONCURRENCY=2
# Optional Urban location order for automatic switching (names as listed in Urban)
# BROWSER_RELAY_URBAN_LOCATIONS=United States (USA),Germany,United Kingdom (UK)
# Auto-update from GitHub releases (relay-v*); check interval in seconds
# BROWSER_RELAY_AUTO_UPDATE=true
# BROWSER_RELAY_UPDATE_SECONDS=60
