<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Covers, episode frames and clip stills we store ourselves (/storage/media/*, symlinked to
# storage/app/public), plus Vite's hashed bundles (/build/*). Every one of those filenames carries a
# content hash or a random version suffix, and a regenerated image always writes a NEW path (see
# App\Support\ImageStore::putCover), so a stored file can never change underneath a cached copy — it
# is safe to cache forever, and it HAS to be, or pulling covers off the source sites buys nothing.
# Without this the origin sends no Cache-Control at all and Cloudflare falls back to its 4-hour
# default Browser Cache TTL, so every visitor re-downloads the same covers several times a day.
#
# Matched on the request path, NOT a bare <FilesMatch> on extension: /assets/* holds hand-replaced
# files (logos, app icons) under stable names, and freezing those for a year would mean the owner
# swapping a logo could not see it change. Both directives are module-guarded so a host without
# mod_headers/mod_setenvif ignores the block instead of 500-ing the site.
#
# The optional `/public` prefix is NOT decoration. On prod the DocumentRoot is public_html/ and the
# root .htaccess rewrites every request into public/ (RewriteRule ^(.*)$ public/$1), so by the time
# Apache evaluates THIS file the URI SetEnvIf tests reads `/public/storage/media/...`, not
# `/storage/media/...`. Anchoring on the bare path matched nothing on the only server that matters
# and the header silently never appeared — verified by probe, not assumed.
<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^(/public)?/storage/media/" NX_IMMUTABLE=1
    SetEnvIf Request_URI "^(/public)?/build/" NX_IMMUTABLE=1
</IfModule>
<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable" env=NX_IMMUTABLE
</IfModule>

# Hotlink protection for the images we store ourselves.
#
# We pay to fetch, clean, re-encode and watermark every cover (App\Support\ImageStore,
# App\Support\PosterWatermark). Another site can embed those files straight from us: they get free
# artwork, we get the bandwidth bill, and our watermark advertises for them. This refuses an image
# request whose Referer is somebody else's page.
#
# An EMPTY Referer is allowed on purpose, and that is not a loophole — it is the whole reason this is
# safe to switch on. The mobile app sends none, Discord/LINE/Facebook link unfurlers send none, and a
# browser opening an image in its own tab sends none. Blocking those would break the app's covers and
# every shared link, which is a far bigger loss than the hotlinking. What this stops is the specific
# case we can be certain about: an <img> tag on a page that is not ours.
#
# KNOW WHAT THIS DOES NOT COVER. It only runs when the request reaches the origin. Covers are served
# with `max-age=31536000, immutable`, so once Cloudflare has one cached the edge answers it directly
# and this rule is never consulted. Measured 2026-08-21 on the same file: a cache MISS with a foreign
# Referer → 403, a cache HIT with the same foreign Referer → 200. In other words it protects the
# images nobody has asked for yet, and not the popular ones — which are exactly the ones worth taking.
#
# A previous session (2026-07-05) reached the same conclusion and DELETED the rule. It is kept this
# time because it is free and does close the miss case, but it is not the fix: the fix is Cloudflare's
# own Hotlink Protection (dashboard → Scrape Shield), which runs at the edge where the cache is. Until
# that toggle is on, treat cover hotlinking as OPEN, not solved.
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} ^(/public)?/storage/media/ [NC]
    RewriteCond %{HTTP_REFERER} !^$
    RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)*netwix\.online [NC]
    RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)*google\. [NC]
    RewriteCond %{HTTP_REFERER} !^https?://([a-z0-9-]+\.)*bing\.com [NC]
    RewriteRule ^ - [F,L]
</IfModule>
